. do "source/derived/04_merging/02_create_section_4_data.do" 

. /*
> Purpose: Create data for the Vatican II DiD
> Primary author: Max Miller
> Contributors: Paul Kim
> Date: 11-24-2025
> Details: Merging events data drops returns for BMU who do not have sufficient 
>     return data to be included in analysis anyway. Merging autocracy info drops
>     CDR, KSV, and TMP who are not included in the analysis anyway.
> */
. 
. * ===========================================================================
. * Housekeeping
. * ===========================================================================
. 
. clear all

. version 19

. 
. * ===========================================================================
. * Set globals
. * ===========================================================================
. 
. global ANALYSIS_DERIVED "datastore/derived/analysis"

. global ASSETS_DERIVED "datastore/derived/assets"

. global MACRO_POLITICAL_DERIVED "datastore/derived/macro_political"

. global EVENTS_DERIVED "datastore/derived/events"

. 
. global START_YEAR = 1946

. global END_YEAR = 1983

. 
. global TREATMENT_START_YEAR = 1959

. global TREATMENT_END_YEAR = 1963

. 
. global MAJ_CATH_AUTO    ARG BOL BRA ECU ESP MEX PER PHL PRT

. global NON_CATH_AUTO    EGY GHA HKG IDN KEN MMR MYS NGA SGP THA ZAF ZWE

. global MAJ_CATH_DEMO    BEL FRA CHL IRL ITA VEN

. global NON_CATH_DEMO    AUS CAN CHE DEU DNK FIN GBR IND JPN LKA NLD NOR NZL SWE TTO USA

. 
. global ALL_AUTO $MAJ_CATH_AUTO $NON_CATH_AUTO

. global ALL_DEMO $MAJ_CATH_DEMO $NON_CATH_DEMO

. global INCLUDED_COUNTRIES $MAJ_CATH_AUTO $NON_CATH_AUTO $MAJ_CATH_DEMO $NON_CATH_DEMO

.     
. * ===========================================================================
. * Main execution logic
. * ===========================================================================
. 
. program define main
  1. 
.     use "${ASSETS_DERIVED}/all_excess_and_abnormal_returns.dta", clear
  2.     merge 1:1 country year using "${EVENTS_DERIVED}/all_events.dta", nogen
  3.     merge 1:1 country year using "${MACRO_POLITICAL_DERIVED}/real_gdp.dta", nogen
  4.     merge 1:1 country year using "${MACRO_POLITICAL_DERIVED}/democracy_index_and_regime_info.dta", nogen
  5.     merge 1:1 country year using "${MACRO_POLITICAL_DERIVED}/gini_coefficients.dta", nogen
  6.     merge 1:1 country year using "${MACRO_POLITICAL_DERIVED}/resource_inequality.dta", nogen
  7.         merge 1:1 country year using "${ASSETS_DERIVED}/all_cashflow_growth.dta", nogen
  8.         merge 1:1 country year using "${MACRO_POLITICAL_DERIVED}/gov_rev.dta", nogen
  9.     merge 1:1 country year using "${MACRO_POLITICAL_DERIVED}/all_inflation.dta", nogen
 10.     merge m:1 country using "${MACRO_POLITICAL_DERIVED}/catholic_pct_1939_1983.dta", nogen
 11. 
.     gen included_countries = 0
 12.     foreach c in $INCLUDED_COUNTRIES {
 13.         replace included_countries = 1 if country == "`c'"
 14.     }
 15. 
.     * KOR and PRY have 20 or more but none in pre/post period
.     tab country if included_countries != 1 & all_exc_ret != . & year >= 1946 & year <= 1983
 16. 
.     keep if included_countries == 1
 17. 
.     tsset country_id year
 18. 
.     * Re-examine this to see if it is still used.
.     gen default_first_5 = default_start
 19.     replace default_first_5 = 1 if L.default_start == 1
 20.     replace default_first_5 = 1 if L2.default_start == 1
 21.     replace default_first_5 = 1 if L3.default_start == 1
 22.     replace default_first_5 = 1 if L4.default_start == 1
 23. 
.         
.         ** Majority catholic autocracies
.     gen maj_cath_aut2 = 0
 24.     foreach c in $MAJ_CATH_AUTO {
 25.                 replace maj_cath_aut2 = 1 if country == "`c'"
 26.         }
 27. 
.     gen maj_cath_aut2_post = maj_cath_aut2 if year >= 1964 & year <= 1983
 28.     replace maj_cath_aut2_post = 0 if year >= 1946 & year <= 1958
 29.         
.         * Fill in democratizations (and autocratization)
.     replace maj_cath_aut2_post = 0 if country == "PRT" & year >= 1976
 30.     replace maj_cath_aut2_post = 0 if country == "ESP" & year >= 1978
 31.     replace maj_cath_aut2_post = 0 if country == "ECU" & year >= 1980
 32.     replace maj_cath_aut2_post = 0 if country == "PER" & year >= 1981
 33.     replace maj_cath_aut2_post = 1 if country == "CHL" & year >= 1973
 34. 
.     gen maj_cath_aut2_post_long = maj_cath_aut2_post
 35.     replace maj_cath_aut2_post_long = 0 if year >= 1939 & year <= 1946 
 36. 
.         ** Majority catholic democracies
.     gen maj_cath_dem2 = 0
 37.     foreach c in $MAJ_CATH_DEMO {
 38.                 replace maj_cath_dem2 = 1 if country == "`c'"
 39.         }
 40.         
.     gen maj_cath_dem2_post = maj_cath_dem2 if year >= 1964 & year <= 1983
 41.     replace maj_cath_dem2_post = 0 if year >= 1946 & year <= 1958
 42. 
.         * Fill in autocratization
.     replace maj_cath_dem2_post = 0 if country == "CHL" & year >= 1973
 43. 
.     gen maj_cath_dem2_post_long = maj_cath_dem2_post
 44.     replace maj_cath_dem2_post_long = 0 if year >= 1939 & year <= 1946 
 45. 
.         ** Non-catholic autocracies
.     gen non_cath_auto2 = 0
 46.     foreach c in $NON_CATH_AUTO {
 47.                 replace non_cath_auto2 = 1 if country == "`c'"
 48.         }
 49.         
.         ** Get all autocracies
.     gen autSample2 = 0
 50.     foreach c in $ALL_AUTO {
 51.                 replace autSample2 = 1 if country == "`c'"
 52.         }
 53.         
. 
.         ** Get all democracies
.         gen demSample2 = 0
 54.     foreach c in $ALL_DEMO {
 55.                 replace demSample2 = 1 if country == "`c'"
 56.         }
 57.         
.         ** Fill in missing GDP observations for NGA, TTO, and ZWE
.         foreach c in NGA TTO ZWE {
 58.                 qui reg log_ggdc_gdppc_i F.log_ggdc_gdppc_i if country == "`c'"
 59.                 forvalues y = 1949(-1)1945 {
 60.                         di `y'
 61.                         replace log_ggdc_gdppc_i = _b[_cons]+_b[F.log_ggdc_gdppc_i]*F.log_ggdc_gdppc_i if year == `y' & country == "`c'" & log_ggdc_gdppc_i == .
 62.                 }
 63.         }
 64. 
.     replace log_ggdc_gdppc_i_g = D.log_ggdc_gdppc_i
 65. 
.         
.     save "${ANALYSIS_DERIVED}/section_4_data.dta", replace
 66. end

. 
. 
. * ===========================================================================
. * Run script
. * ===========================================================================
. 
. main
