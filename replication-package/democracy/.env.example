# =============================================================================
# Environment Configuration
# =============================================================================
# Copy to .env and fill in your paths

# Required: Set to the absolute path of this repository
ROOT_PATH=/path/to/democracy
DATASTORE_PATH=/path/to/democracy/datastore

# Optional: Override Stata executable name (default: StataMP)
# Common values: stata-mp (Linux), StataSE, StataMP
# JMSLAB_EXE_STATA=stata-mp
