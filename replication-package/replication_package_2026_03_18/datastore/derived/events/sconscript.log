. * ==============================================================================
. * Set globals
. * ==============================================================================
. 
. global EVENTS_DERIVED "datastore/derived/events"

. 
. * ==============================================================================
. * Main execution logic
. * ==============================================================================
. 
. program main
  1. 
.     use "${EVENTS_DERIVED}/regime_change.dta", clear
  2.         merge 1:1 country year using "${EVENTS_DERIVED}/coup_detat.dta", keep(1 3) nogen
  3.         merge 1:1 country year using "${EVENTS_DERIVED}/financial_crisis.dta", keep(1 3) nogen
  4.         merge 1:1 country year using "${EVENTS_DERIVED}/default.dta", keep(1 3) nogen
  5.         merge 1:1 country year using "${EVENTS_DERIVED}/head_of_government_deaths.dta", keep(1 3) nogen
  6.         merge 1:1 country year using "${EVENTS_DERIVED}/icb_crisis.dta", keep(1 3) nogen
  7.         merge 1:1 country year using "${EVENTS_DERIVED}/recession.dta", keep(1 3) nogen
  8.         merge 1:1 country year using "${EVENTS_DERIVED}/interstate_wars.dta", keep(1 3) nogen
  9.         merge 1:1 country year using "${EVENTS_DERIVED}/intrastate_wars.dta", keep(1 3) nogen
 10.         merge 1:1 country year using "${EVENTS_DERIVED}/extrastate_wars.dta", keep(1 3) nogen
 11.         merge 1:1 country year using "${EVENTS_DERIVED}/militarized_interstate_disputes.dta", keep(1 3) nogen
 12.         
.         local political_events coup_detat govt_head_death assas_succ assas_attempt icb_crisis
 13.         local interstate_wars interstate_war interstate_war_near interstate_war_far 
 14.         local intrastate_wars intrastate_war intrastate_war_near intrastate_war_far 
 15.         local extrastate_wars extrastate_war extrastate_war_near extrastate_war_far
 16.         local economic_events financial_crisis default recession
 17. 
.         foreach var in `political_events' `economic_events' `interstate_wars' `intrastate_wars' `extrastate_wars' {
 18.                 replace `var' = 0 if `var' == .
 19.         }
 20. 
.         replace md_high_action = 0 if md_high_action == .
 21. 
.         tsset country_id year
 22.         create_event_columns "aut_ep"
 23.         create_event_columns "default"
 24.         create_event_columns "financial_crisis"
 25.         create_event_columns "icb_crisis"
 26.         create_event_columns "recession"
 27.         create_event_columns "interstate_war"
 28.         create_event_columns "intrastate_war"
 29.         create_event_columns "extrastate_war"
 30. 
.         lab var default_start "Default start year == 1"
 31.         lab var default_ep_id "Default episode identifier"
 32.         lab var years_in_default "Number of years in default
 33.         
.         lab var financial_crisis_start "Financial crisis start year == 1"
 34.         lab var financial_crisis_ep_id "Financial crisis episode identifier"
 35.         lab var years_in_financial_crisis "Number of years in financial crisis"
 36.         
.         egen at_war = rowmax(interstate_war intrastate_war extrastate_war)
 37.         gen at_war_start = 1 if at_war == 1 & L.at_war == 0
 38.         replace at_war_start = 0 if at_war_start == .
 39.         
.         egen adverse_event = rowmax(financial_crisis default recession at_war)
 40.         gen adverse_event_start = 1 if adverse_event == 1 & L.adverse_event == 0
 41.         replace adverse_event_start = 0 if adverse_event_start == .
 42. 
.         gen adverse_event2 = 1 if interstate_war_near == 1
 43.         replace adverse_event2 = 1 if intrastate_war_near == 1 & adverse_event2 == .
 44.         replace adverse_event2 = 1 if default == 1 & years_in_default < 10 & adverse_event2 == .
 45.         replace adverse_event2 = 0 if adverse_event2 == .
 46.         
.     gen combo_dem_minus_start = combo_dem_start
 47.     replace combo_dem_minus_start = 0 if adverse_event2 == 1
 48. 
.         gen combo_dem_minus = combo_dem_minus_start
 49.         replace combo_dem_minus = 1 if L.combo_dem_minus == 1 & combo_dem == 1
 50.         
.     gen aut_ep_minus_start = aut_ep_start
 51.     replace aut_ep_minus_start = 0 if adverse_event2 == 1
 52. 
.         gen aut_ep_minus = aut_ep_minus_start
 53.         replace aut_ep_minus = 1 if L.aut_ep_minus == 1 & aut_ep == 1
 54.         
.     gen icb_crisis_minus_start = icb_crisis_start
 55.     replace icb_crisis_minus_start = 0 if adverse_event2 == 1
 56. //      replace icb_crisis_minus_start = 0 if combo_dem == 1
. 
.         gen icb_crisis_minus = icb_crisis_minus_start
 57.         replace icb_crisis_minus = 1 if L.icb_crisis_minus == 1 & icb_crisis == 1
 58. 
.     egen political_crisis = rowmax(coup_detat regime_change) 
 59.     replace political_crisis = 0 if combo_dem_minus == 1
 60.     replace political_crisis = 0 if aut_ep_minus == 1
 61.     replace political_crisis = 0 if icb_crisis_minus == 1
 62.     gen political_crisis_minus = political_crisis
 63.     replace political_crisis_minus = 0 if adverse_event2 == 1
 64. 
.     gen political_crisis_minus_start = 1 if political_crisis_minus == 1 & L.political_crisis_minus == 0
 65.     replace political_crisis_minus_start = 0 if political_crisis_minus_start == .
 66. 
.         gen L_political_crisis_minus_start = L.political_crisis_minus_start
 67.         
.     save "${EVENTS_DERIVED}/all_events.dta", replace
 68. 
. end

. 
