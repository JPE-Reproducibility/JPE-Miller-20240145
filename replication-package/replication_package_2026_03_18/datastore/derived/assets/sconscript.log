. do "source/derived/03_assets/10_create_return_news.do" 

. /*
> Purpose: Run Campbell (1991 VAR) for all 5 variable combinations
> Primary author: Max Miller
> Date: 12-12-2025
> */
. 
. clear all

. version 19

. 
. global ASSETS_DERIVED                   "datastore/derived/assets"

. global MACRO_POLITICAL_DERIVED  "datastore/derived/macro_political"

. global PROGRAMS                                 "source/derived/programs"

. 
. do "${PROGRAMS}/run_campbell_1991_var.do"

. 
. program run_campbell_1991_var
  1. 
. args country varlist
  2. 
. local n_vars : word count `varlist'
  3. 
. * Compute rho from mean of discount rate
. sum $dy if country_id == `country'
  4. sca rho = exp(-r(mean)) / (1 + exp(-r(mean)))
  5. 
. * Demean variables
. foreach var of varlist `varlist' {
  6.         egen mn_`var' = mean(`var')
  7.         gen dmn_`var' = `var' - mn_`var'
  8. }
  9. 
. * Build demeaned varlist
. local dmn_varlist ""
 10. foreach var of varlist `varlist' {
 11.         local dmn_varlist "`dmn_varlist' dmn_`var'"
 12. }
 13. 
. * Run VAR
. var `dmn_varlist' if country_id == `country', lag(1) nocons
 14. 
. * Extract Phi matrix from r(table)
. mat temp_mat = r(table)
 15. mat Phi = J(`n_vars', `n_vars', .)
 16. forval i = 1/`n_vars' {
 17.         forval j = 1/`n_vars' {
 18.                 local col = (`i' - 1) * `n_vars' + `j'
 19.                 mat Phi[`i', `j'] = temp_mat[1, `col']
 20.         }
 21. }
 22. 
. * Predict residuals
. forval i = 1/`n_vars' {
 23.         predict var_res`i', residuals equation(#`i')
 24. }
 25. 
. * Create matrices from data
. mkmat `varlist' if e(sample) == 1, mat(data_mat)
 26. mkmat var_res* if e(sample) == 1, mat(res_mat)
 27. mkmat year country_id if e(sample) == 1, mat(info_mat)
 28. 
. * Compute Campbell decomposition
. mat iden = I(`n_vars')
 29. mat e1 = J(`n_vars', 1, 0)
 30. mat e1[1, 1] = 1
 31. mat lambda = rho * e1' * Phi * inv(iden - rho * Phi)
 32. 
. mat cf_news = ((e1' + lambda) * res_mat')'
 33. mat dr_news = (lambda * res_mat')'
 34. 
. * Append to output matrix
. mat var_mat = (info_mat, cf_news, dr_news)
 35. mat colnames var_mat = "year" "country_id" "cf_news_camp" "dr_news_camp"
 36. mat shocks_mat = (shocks_mat \ var_mat)
 37. 
. drop mn_* dmn_* var_res*
 38. 
. end

. 
end of do-file

. 
. global rt   "log_all_eq_tr"

. global rft  "log_all_bond_rate"

. global div  "log_gfd_div_yld"

. global cg   "log_all_eq_capgain"

. global gdpg "log_ggdc_gdppc_i_g"

. global dy   "log_all_div_yld"

. 
. global MIN_OBS = 20

. 
. * ==============================================================================
. * Main execution logic
. * ==============================================================================
. 
. program main
  1. 
.         get_var_data
  2.         
.         preserve
  3.         keep country_id country
  4.         duplicates drop
  5.         tempfile country_id_map
  6.         save "`country_id_map'"
  7.         restore
  8.         
.         tempfile var_data
  9.         save "`var_data'"
 10.         
.         * Run VAR for each combination
.         local comb1 "$rt $div $rft $cg $gdpg"
 11.         local comb2 "$rt $div $cg $gdpg"
 12.         local comb3 "$rt $div $rft"
 13.         local comb4 "$rt $div $cg"
 14.         local comb5 "$rt $cg $gdpg"
 15.         
.         forval i = 1/5 {
 16.                 use "`var_data'", clear
 17.                 run_var_for_comb `i' "`comb`i''"
 18.                 tempfile shocks`i'
 19.                 save "`shocks`i''"
 20.         }
 21.         
.         * Merge all shocks together
.         use "`shocks1'", clear
 22.         forval i = 2/5 {
 23.                 merge 1:1 country_id year using "`shocks`i''", nogen
 24.         }
 25.         
.         merge m:1 country_id using "`country_id_map'", keep(3) nogen
 26.         drop country_id
 27.         
.         foreach var in cf dr {
 28.                 gen `var'_news_eq_tr = `var'_news_1
 29.                 replace `var'_news_eq_tr = `var'_news_2 if `var'_news_eq_tr == .
 30.                 replace `var'_news_eq_tr = `var'_news_3 if `var'_news_eq_tr == .
 31.                 replace `var'_news_eq_tr = `var'_news_4 if `var'_news_eq_tr == .
 32.                 replace `var'_news_eq_tr = `var'_news_5 if `var'_news_eq_tr == .
 33.         }
 34.         
. //      keep country year dr_news_eq_tr cf_news_eq_tr
.         order country year dr_news_eq_tr cf_news_eq_tr
 35.         
.         save "${ASSETS_DERIVED}/campbell_1991_var_shocks.dta", replace
 36. 
. end

. 
. program run_var_for_comb
  1. 
.         args comb_num varlist
  2.         
.         preserve
  3.         
.         mat shocks_mat = J(1, 4, .)
  4.         levelsof country_id if ret_obs >= $MIN_OBS & avg_div_yld != .
  5.         local countries = r(levels)
  6. 
.         foreach c of local countries {
  7.                 * Check if enough observations for this combination
.                 local miss_cond "country_id == `c'"
  8.                 foreach v of local varlist {
  9.                         local miss_cond "`miss_cond' & `v' != ."
 10.                 }
 11.                 qui count if `miss_cond'
 12.                 if r(N) >= $MIN_OBS {
 13.                         qui run_campbell_1991_var `c' "`varlist'"
 14.                 }
 15.         }
 16.                 
.         * Convert shocks matrix to dataset
.         clear
 17.         svmat shocks_mat
 18.         rename shocks_mat1 year
 19.         rename shocks_mat2 country_id
 20.         rename shocks_mat3 cf_news_`comb_num'
 21.         rename shocks_mat4 dr_news_`comb_num'
 22.         drop if year == .
 23.         
.         restore, not
 24. 
. end

. 
. program get_var_data
  1. 
.         use "${ASSETS_DERIVED}/all_equity_returns.dta", clear
  2.         merge 1:1 country year using "${ASSETS_DERIVED}/all_fixed_income.dta", nogen
  3.         merge 1:1 country year using "${ASSETS_DERIVED}/all_div_yld.dta", nogen
  4.         merge 1:1 country year using "${MACRO_POLITICAL_DERIVED}/real_gdp.dta", nogen
  5.         sort country year
  6.                 
.         egen country_id = group(country), label
  7.         tsset country_id year
  8.         
.         gen log_all_div_yld = log_gfd_div_yld
  9.         replace log_all_div_yld = log_jst_div_yld if log_all_div_yld == .
 10.         replace log_all_div_yld = log_factset_div_yld if log_all_div_yld == .
 11.         replace log_all_div_yld = log_ibes_div_yld if log_all_div_yld == .
 12.         replace log_all_div_yld = log_gfd_lse_div_yld if log_all_div_yld == .
 13. 
.         keep country_id year country $rt $rft $div $cg $gdpg $dy
 14. 
.         bys country_id: egen ret_obs = total($rt != .)
 15.         drop if ret_obs == 0 | $rt == .
 16. 
.         bys country_id: egen avg_div_yld = mean($dy)
 17.         
. end

. 
