. do "source/derived/02_macro_political/05_create_portion_catholic.do" 

. /*
> Purpose: create religion variables for main paper and appendix
> Primary author: Max Miller
> Contributors: Paul Kim
> Date: 11-14-2025
> */
. 
. * ===========================================================================
> ===
. * Housekeeping
. * ===========================================================================
> ===
. 
. clear all

. version 19

. 
. * ===========================================================================
> ===
. * Set globals
. * ===========================================================================
> ===
. 
. global RELIGION_ORIG                    "datastore/raw/cow/religion/orig"

. global CROSSWALKS                               "datastore/raw/crosswalks"

. global MACRO_POLITICAL_DERIVED  "datastore/derived/macro_political"

. 
. global START_YEAR = 1816

. global END_YEAR = 2018

. 
. global DID_START_YEAR = 1939

. global DID_END_YEAR = 1983

. 
. * ===========================================================================
> ===
. * Main execution logic
. * ===========================================================================
> ===
. 
. program main
  1. 
.         prepare_cow_iso3_crosswalk
  2.         tempfile country_codes_map
  3.         save "`country_codes_map'"
  4. 
.         * Load in % catholic
.         import delimited "${RELIGION_ORIG}/WRP_national.csv", varnames(1) cle
> ar
  5.         rename state ccode
  6.         merge m:1 ccode using "`country_codes_map'", keep(3) nogen
  7.     keep country year chrstcatpct
  8.     order country year chrstcatpct
  9.     rename chrstcatpct catholic_pct
 10.     sort country year
 11.         
.         * Deals with East-West Germany (keeps West), Vietnam, and Yemen
.         collapse (max) catholic_pct, by(country year)
 12.         
.         * Fill in information for Hong Kong with China data
.         preserve
 13.         fill_in_hong_kong
 14.         tempfile HKG_fill
 15.         save "`HKG_fill'"
 16.         restore
 17. 
.         append using "`HKG_fill'"
 18. 
.         fill_from_1816_2018
 19.         
.     gen majority_catholic = 1 if catholic_pct > .5 & catholic_pct != .
 20.     replace majority_catholic = 0 if majority_catholic == . & catholic_pct
>  != .
 21.     gen non_catholic = 1-majority_catholic
 22.         
.         * Discards invalid ISO3 codes referenced in valid_iso3_codes.dta crea
> tion script
.         merge m:1 country using "${CROSSWALKS}/valid_iso3_codes.dta", keep(3)
>  nogen
 23.         
.         save "${MACRO_POLITICAL_DERIVED}/catholic_pct_1816_2018.dta", replace
 24. 
.         keep if year >= $DID_START_YEAR & year <= $DID_END_YEAR
 25.         collapse (mean) catholic_pct, by(country)
 26.         
.     gen majority_catholic = 1 if catholic_pct > .5 & catholic_pct != .
 27.     replace majority_catholic = 0 if majority_catholic == . & catholic_pct
>  != .
 28.     gen non_catholic = 1-majority_catholic
 29. 
.         save "${MACRO_POLITICAL_DERIVED}/catholic_pct_1939_1983.dta", replace
 30.         
. end

. 
. program prepare_cow_iso3_crosswalk
  1.         * Load in COW to ISO3 crosswalks
.         import delimited "${CROSSWALKS}/cow_country_codes_to_iso3.csv", varna
> mes(1) clear
  2.         drop if ccode == .
  3.         keep ccode country
  4.         duplicates drop
  5. end

. 
. program fill_in_hong_kong
  1. 
.         keep if country == "CHN"
  2.         replace country = "HKG"
  3. 
.         * Add a 1816 observation for filling
.         set obs `=_N+1'
  4.         replace year = $START_YEAR in `=_N'
  5.         replace country = "HKG" in `=_N'
  6.         
.         * Add a 2018 observation for filling
.         set obs `=_N+1'
  7.         replace year = $END_YEAR in `=_N'
  8.         replace country = "HKG" in `=_N'
  9.         
. end

. 
. program fill_from_1816_2018
  1. 
.         egen i = group(country), label
  2.         tsset i year
  3.         tsfill, full
  4. 
.         decode i, gen(country_temp)
  5.         replace country = country_temp if country == ""
  6.         
.     bys i: ipolate catholic_pct year, gen(catholic_pct_i)
  7.         replace catholic_pct = catholic_pct_i if catholic_pct == .
  8.         
.         gsort i -year
  9.         bys i: replace catholic_pct = catholic_pct[_n-1] if catholic_pct =
> = .
 10.         gsort i year
 11.         bys i: replace catholic_pct = catholic_pct[_n-1] if catholic_pct =
> = .
 12. 
.         drop country_temp i catholic_pct_i
 13.         
. end

. 
